   "ppr": {
    "ind": {
     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "2.标签名称中不允许出现空格（空格都以下划线替代）、中文以及特殊符号",
     "p": {}
    }
   ],
   "text": "2.标签名称中不允许出现空格（空格都以下划线替代）、中文以及特殊符号",
