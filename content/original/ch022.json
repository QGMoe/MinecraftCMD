   "raw": "[/CENTER]",
   "close": true
  },
  {
   "tag": "HEADING",
   "raw": "[/HEADING]",
   "close": true
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "CENTER",
   "raw": "[CENTER]"
  },
  {
   "tag": "I",
   "raw": "[I]"
  },
  {
   "text": "2020年1月8日 13:43 1039字"
  },
  {
