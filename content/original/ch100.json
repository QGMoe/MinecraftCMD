   "c": [
    {
     "t": "在正式开始NBT的学习过程前，我们得详细了解Minecraft Java的一次重大更新：",
     "p": {}
    }
   ],
   "text": "在正式开始NBT的学习过程前，我们得详细了解Minecraft Java的一次重大更新：",
   "sha256": "dca05c0aaa0973fb00d679b40fe733c1bf2aaea62d1b99622bf104acfe2f1aa7",
   "i": 7832
  },
  {
   "ppr": {
    "ind": {
