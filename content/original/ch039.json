   "ppr": {
    "ind": {
     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "看起来粒子效果很高级。其实，使用粒子效果只需要一条指令：",
     "p": {
      "font": {
       "hint": "eastAsia"
      }
     }
    },
    {
     "t": "/particle。",
     "p": {}
    }
   ],
   "text": "看起来粒子效果很高级。其实，使用粒子效果只需要一条指令：/particle。",
