     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "remove——移除目标玩家指定的迷雾设置以及设置中包含的所有迷雾效果",
     "p": {}
    }
   ],
   "text": "remove——移除目标玩家指定的迷雾设置以及设置中包含的所有迷雾效果",
   "sha256": "e3306f86be1b64b5381efa373e8ebc7a9eb14afbfcba4c240a5073cb9f96b115",
   "i": 6017
  },
  {
   "ppr": {
    "ind": {
     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "那么",
     "p": {
      "font": {
       "hint": "eastAsia"
      }
     }
    },
    {
     "t": "/fog子命令到底该怎么使用？",
     "p": {}
