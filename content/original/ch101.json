   "c": [
    {
     "t": "在开始了解物品的NBT标签之前，我们得先填一点第五十四章的坑：数组",
     "p": {}
    }
   ],
   "text": "在开始了解物品的NBT标签之前，我们得先填一点第五十四章的坑：数组",
   "sha256": "949fe2594dee5a4f776dba7db26fafc489694e1893edc6fbb64120cc5bea65fc",
   "i": 7917
  },
