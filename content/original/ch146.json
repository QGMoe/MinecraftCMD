   ],
   "text": "这是什么东西？你捡起来，一看：哦吼，火焰弹。",
   "sha256": "ebf1ba6cef14ea7e4f394c4e0716ae59c20e0fb4c8de0d77da1514dde54648e9",
   "i": 12004
