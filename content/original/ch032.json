   "c": [
    {
     "t": "其中，选取区域的模式和",
     "p": {
      "font": {
       "hint": "eastAsia"
      }
     }
    },
    {
     "t": "/fill是一样的，即选定区域的对角坐标。虽然这里选取时有使用Y轴，但由于区块并不考虑Y轴，其实没多大用处。",
     "p": {}
