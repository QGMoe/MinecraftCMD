      "font": {
       "hint": "eastAsia"
      }
     }
    }
   ],
   "text": "第一个差异：种类",
   "sha256": "f48b92929c45665741b1bc6599229ad9accdc77ad5b6eff721d6ddd9a92aed38",
   "i": 4125
  },
