   "ppr": {
    "ind": {
     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "关于命名空间更深入的研究以后再来，现在让我们来看看ID参数普遍的格式：",
     "p": {}
    }
   ],
   "text": "关于命名空间更深入的研究以后再来，现在让我们来看看ID参数普遍的格式：",
