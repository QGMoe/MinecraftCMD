   "arg": "rgb(226, 80, 65)"
  },
  {
   "text": "　　食用本书前请先看这里！"
  },
  {
   "tag": "COLOR",
   "raw": "[/COLOR]",
   "close": true
  },
  {
   "tag": "B",
   "raw": "[/B]",
   "close": true
