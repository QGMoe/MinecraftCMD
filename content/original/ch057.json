   "ppr": {
    "ind": {
     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "①目标必须手持着需要附魔的物品，如果没有手持指定物品将会附魔失败。",
     "p": {
      "font": {
       "hint": "eastAsia"
      }
