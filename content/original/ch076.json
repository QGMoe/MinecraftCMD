   "ppr": {
    "ind": {
     "firstLine": "420"
    }
   },
   "c": [
    {
     "t": "我们可以尝试添加更多的参数，比如指定多强的摇晃强度和摇晃时间：",
     "p": {
      "font": {
       "hint": "eastAsia"
      }
     }
    }
   ],
   "text": "我们可以尝试添加更多的参数，比如指定多强的摇晃强度和摇晃时间：",
   "sha256": "e8eeb40777a96335629759323e62fdcf16c42603e934a447790145d551411934",
