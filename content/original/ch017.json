  {
   "tag": "COLOR",
   "raw": "[/COLOR]",
   "close": true
  },
  {
   "tag": "B",
   "raw": "[/B]",
   "close": true
  },
  {
   "text": "』、『"
  },
  {
   "tag": "B",
   "raw": "[B]"
  },
  {
   "tag": "COLOR",
   "raw": "[COLOR=rgb(44, 130, 201)]",
   "arg": "rgb(44, 130, 201)"
  },
  {
   "text": "栏位-值对"
  },
  {
   "tag": "COLOR",
   "raw": "[/COLOR]",
   "close": true
  },
  {
   "tag": "B",
   "raw": "[/B]",
   "close": true
  },
  {
   "text": "』、『"
  },
  {
   "tag": "B",
   "raw": "[B]"
  },
  {
   "tag": "COLOR",
   "raw": "[COLOR=rgb(44, 130, 201)]",
   "arg": "rgb(44, 130, 201)"
