  {
   "tag": "CENTER",
   "raw": "[/CENTER]",
   "close": true
  },
  {
   "text": "\r\n\r\n　　就可以显示一个浅紫色的“"
  },
  {
   "tag": "FONT",
   "raw": "[FONT=Unifont]",
   "arg": "Unifont"
