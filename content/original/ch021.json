  {
   "text": "　　三. "
  },
  {
   "tag": "COLOR",
   "raw": "[COLOR=rgb(44, 130, 201)]",
   "arg": "rgb(44, 130, 201)"
  },
  {
   "text": "/locate"
  },
  {
   "tag": "COLOR",
   "raw": "[/COLOR]",
   "close": true
  },
