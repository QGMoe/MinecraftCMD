  {
   "tag": "LIST",
   "raw": "[LIST]"
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "*",
   "raw": "[*]"
  },
  {
   "tag": "FONT",
   "raw": "[FONT=SimSun]",
   "arg": "SimSun"
  },
  {
