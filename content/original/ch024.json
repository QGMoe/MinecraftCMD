   "close": true
  },
  {
   "tag": "HEADING",
   "raw": "[/HEADING]",
   "close": true
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "TABLE",
   "raw": "[TABLE]"
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "TR",
   "raw": "[TR]"
  },
  {
   "text": "\r\n"
  },
  {
