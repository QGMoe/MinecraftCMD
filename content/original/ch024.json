  },
  {
   "text": "更新内容"
  },
  {
   "tag": "CENTER",
   "raw": "[/CENTER]",
   "close": true
  },
  {
   "tag": "TH",
   "raw": "[/th]",
   "close": true
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "TR",
   "raw": "[/TR]",
   "close": true
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "TR",
   "raw": "[TR]"
  },
  {
   "text": "\r\n"
  },
  {
   "tag": "TD",
   "raw": "[td width=\"15%\"]",
   "attrs": "width=\"15%\""
  },
  {
   "tag": "CENTER",
   "raw": "[CENTER]"
  },
  {
   "text": "1.0.0"
  },
  {
   "tag": "CENTER",
   "raw": "[/CENTER]",
   "close": true
